@page "/tasks"
@rendermode InteractiveServer
@using MySqlConnector
@inject MySqlConnection Connection

<h1>Tasks</h1>
<p>DB Status: @dbStatus</p>

<h3>Reward points earned: @TotalPoints</h3>
<ul>

@foreach(var task in tasks){
    <li class="taskList">
        <div class="taskContainer">
        <p>Title: @task.Title</p>
        <p>Description: @task.Description</p>
        <p>Rewardpoints: @task.RewardPoints</p>
        <div class="completedTask">
            <p>Completed?</p>
            <br>
             <input type="checkbox" placeholder="Completed?" class="completedInput" checked="@task.Completed" @onchange="() => ToggleCompleted(task)">
        </div>
        </div>
        
     </li>
}

</ul>


<input @bind="newTaskTitle" placeholder="Title"/>
<input type="text" @bind="newTaskDescription"  placeholder="Description"/>
<input type="number" @bind="completionPoints" placeholder="Rward Points"/>
<button @onclick="AddTask" class="k">
    <span class="bi bi-plus-circle-fill" aria-hidden="true"></span>
    Add task
</button>

@code{

    private List<TaskItem> tasks = new();

    string newTaskTitle = "";
    string newTaskDescription = "";
    bool completed = false;

    int completionPoints = 0;

    string dbStatus = "Not tested";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Connection.OpenAsync();
            dbStatus = "✅ Connected to MariaDB!";
            await Connection.CloseAsync();
        }
        catch (Exception ex)
        {
            dbStatus = $"❌ Failed: {ex.Message}";
        }
    }

    int TotalPoints => tasks.Where(t => t.Completed).Sum(t => t.RewardPoints);

    void AddTask(){
        tasks.Add(new TaskItem { Title = newTaskTitle, Description = newTaskDescription, Completed = completed, RewardPoints = completionPoints  });
    }

    void ToggleCompleted(TaskItem task){
        task.Completed = !task.Completed;
    }

}